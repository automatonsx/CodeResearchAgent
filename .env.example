# Scout — environment template. Copy to .env and fill in.  (.env is gitignored)

# --- Azure OpenAI (LLM) ---
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- ChromaDB (best-practices corpus for citation grounding) ---
# Uses ChromaDB's built-in local embeddings by default — no Azure embeddings
# deployment required. Grounding falls back to keyword retrieval if Chroma is absent.
CHROMA_PERSIST_DIR=./data/chroma

# --- semgrep (optional security ground-truth) ---
# Not well-supported on native Windows; if absent, the Security agent uses ruff's
# bandit (S) rules + AST checks. No env var needed — detected automatically.
